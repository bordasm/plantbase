ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."

# Read-write -- ezzel migrál és seedel a Prisma (packages/db).
DATABASE_URL="postgresql://plantbase:plantbase@localhost:5432/plantbase?schema=public"

# Read-only -- ezt használja az agent runSql/listCategories toolja.
DATABASE_URL_READONLY="postgresql://plantbase_ro:plantbase_ro@localhost:5432/plantbase?schema=public"

# apps/server session-kezeléshez
SESSION_COOKIE_NAME="plantbase_session"
SESSION_TTL_DAYS="7"

# apps/server port
SERVER_PORT="3000"
